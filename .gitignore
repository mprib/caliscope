# scripts/ is a local scratch space. A script is committed only once it is a
# demo worth sharing or a workflow tool, such as a widget visualization that
# checks the GUI works and looks as intended. Add it to this list when you do.
scripts/*
!scripts/demo_api.py
!scripts/demo/
scripts/demo/*
!scripts/demo/demo_joint_intrinsic_extrinsic_calibration.py
!scripts/demo/demo_markerless_calibration.py
